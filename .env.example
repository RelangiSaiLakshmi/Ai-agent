# Copy to `.env` and fill in when you wire a real LLM (Milestone 2).
# The Milestone 1 scaffold defaults to the offline MockLLM, so no key is needed yet.

# LLM provider: mock | anthropic  (openai support can be added later)
LLM_PROVIDER=mock

# Model id used when LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# SQLite database path
DB_PATH=data/app.db

# Logging verbosity: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
